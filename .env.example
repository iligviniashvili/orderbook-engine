# Copy to .env for docker compose. The services in docker-compose.yml read
# these; the Rust binaries take their own settings from config/ and OBE__* vars.
POSTGRES_USER=orderbook
POSTGRES_PASSWORD=orderbook
POSTGRES_DB=orderbook
POSTGRES_PORT=5432
REDIS_PORT=6379

# Gateway overrides, e.g.:
# OBE__SERVER__PORT=8080
# OBE__TELEMETRY__FORMAT=json
# OBE__DATABASE__URL=postgres://orderbook:orderbook@localhost:5432/orderbook
# OBE__REDIS__URL=redis://localhost:6379
# RUST_LOG=obe_gateway=debug,info

# Set these to run the storage integration tests against live services.
# OBE_TEST_DATABASE_URL=postgres://orderbook:orderbook@localhost:5432/orderbook
# OBE_TEST_REDIS_URL=redis://localhost:6379
