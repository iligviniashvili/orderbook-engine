# Copy to .env for docker compose. The services in docker-compose.yml read
# these; the Rust binaries take their own settings from config/ and OBE__* vars.
POSTGRES_USER=orderbook
POSTGRES_PASSWORD=orderbook
POSTGRES_DB=orderbook
POSTGRES_PORT=5432
REDIS_PORT=6379

# Gateway overrides, e.g.:
# OBE__SERVER__PORT=8080
# OBE__TELEMETRY__FORMAT=json
# RUST_LOG=obe_gateway=debug,info
